{
  "name": "tvet-resource-portal",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "admin:create": "node scripts/admin.js",
    "jobs": "node scripts/jobs.js",
    "pesapal:ipn": "node scripts/ipn.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "catalogue:import": "node scripts/import-catalogue.js",
    "db:runtime-role": "node scripts/production-role.js",
    "format": "prettier --write --ignore-unknown src scripts public test db docs README.md package.json compose.yaml",
    "subscription:ipn": "node scripts/subscription-ipn.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@napi-rs/canvas": "^1.1.0",
    "@supabase/supabase-js": "^2.57.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  }
}
