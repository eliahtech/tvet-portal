NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Leave blank ONLY for local PGlite development. Production requires PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true
PG_CA_CERT=
DATA_DIR=./data
# Create one PRIVATE bucket: papers. No public read policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=papers
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Number of reverse proxies in front of Express; 0 for direct access.
TRUST_PROXY=0
MAX_UPLOAD_MB=20

# Optional AI StudyMate. Keys stay on the server; never place them in public assets.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.3-70b-versatile
AI_PRIMARY_PROVIDER=gemini
AI_DAILY_LIMIT=30

# Super admin's Pesapal merchant account for ADMIN SUBSCRIPTIONS only.
# No fallback to the paper-sales account. Register this account's separate IPN.
OWNER_PESAPAL_ENV=sandbox
OWNER_PESAPAL_CONSUMER_KEY=
OWNER_PESAPAL_CONSUMER_SECRET=
OWNER_PESAPAL_IPN_ID=
